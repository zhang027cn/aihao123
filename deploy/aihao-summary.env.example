# AI Hao123 摘要服务环境变量（服务器本地）
# 权限必须 0600，仅 root 可读。此文件绝不入库。
# 部署时把下面的 <KEY> 换成真实商汤 key。
SENSENOVA_KEY=<KEY>
SUMMARY_PORT=8790
SUMMARY_CONCURRENCY=2

# 访问控制（见 scripts/summary-server.mjs）
SUMMARY_ORIGIN=https://aihao123.zgc.pub
# 可选共享密钥：设置后前端请求须带 ?token=（需同步改前端，默认留空不用）
# SUMMARY_TOKEN=
# 限流：全局每分钟次数 / 单 IP 每分钟次数
SUMMARY_RATE_LIMIT=60
SUMMARY_IP_LIMIT=12
